resource_group_name = "rg-subnets-example"
location            = "uksouth"
vnet_name           = "vnet-example"
vnet_address_space  = ["10.0.0.0/16"]

subnets = {
  "snet-app" = {
    address_prefixes = ["10.0.1.0/24"]
  }
  "snet-data" = {
    address_prefixes = ["10.0.2.0/24"]
  }
}

tags = {
  environment = "dev"
  project     = "terraform-subnets"
}
